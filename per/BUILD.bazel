load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//bazel:platform.bzl", "ovf_sqlite_platform_bundle")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "provider_abi",
    hdrs = ["include/ovf/per/backend_abi.h"],
    includes = ["include"],
)

cc_library(
    name = "runtime",
    srcs = ["src/runtime.cpp"],
    hdrs = ["include/ovf/per/per.hpp"],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
    deps = [":provider_abi"],
)

cc_library(
    name = "codec",
    hdrs = ["include/ovf/per/codec.hpp"],
    includes = ["include"],
    deps = [":runtime"],
)

cc_library(
    name = "memory_provider",
    srcs = ["backends/memory.cpp"],
    deps = [":provider_abi"],
)

cc_library(
    name = "sqlite_provider",
    srcs = ["backends/sqlite.cpp"],
    deps = [
        ":provider_abi",
        "@jsoncpp",
        "@sqlite_source//:sqlite",
    ],
)

cc_shared_library(
    name = "shared",
    shared_lib_name = select({
        "@platforms//os:osx": "libovf_per.dylib",
        "//conditions:default": "libovf_per.so",
    }),
    deps = [":runtime"],
)

cc_library(
    name = "public_headers",
    hdrs = [
        "include/ovf/per/backend_abi.h",
        "include/ovf/per/codec.hpp",
        "include/ovf/per/per.hpp",
    ],
    includes = ["include"],
)

cc_import(
    name = "api",
    shared_library = ":shared",
    deps = [":public_headers"],
)

cc_shared_library(
    name = "memory_provider_plugin",
    shared_lib_name = select({
        "@platforms//os:osx": "libovf_per_provider_memory.dylib",
        "//conditions:default": "libovf_per_provider_memory.so",
    }),
    deps = [":memory_provider"],
)

cc_shared_library(
    name = "sqlite_provider_plugin",
    shared_lib_name = select({
        "@platforms//os:osx": "libovf_per_provider_sqlite.dylib",
        "//conditions:default": "libovf_per_provider_sqlite.so",
    }),
    deps = [":sqlite_provider"],
)

filegroup(
    name = "sqlite_runtime",
    srcs = [
        ":shared",
        ":sqlite_provider_plugin",
    ],
)

ovf_sqlite_platform_bundle(
    name = "sqlite_platform_bundle",
    framework_license = "//:LICENSE",
    runtime = [":sqlite_runtime"],
    sqlite_notice = "sqlite-NOTICE.txt",
    target_compatible_with = ["@platforms//os:linux"],
)
