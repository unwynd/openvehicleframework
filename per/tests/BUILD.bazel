load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//bazel:persistency.bzl", "ovf_per_application", "ovf_per_contract")

package(default_visibility = ["//visibility:public"])

exports_files(["deployment.cue"])

ovf_per_contract(
    name = "typed_state",
    idl = ["state.smithy"],
    output_name = "typed-state",
)

cc_test(
    name = "typed_contract_test",
    srcs = ["typed_contract_test.cpp"],
    deps = [
        ":typed_state",
        "//per:memory_provider",
        "@googletest//:gtest_main",
    ],
)

ovf_per_application(
    name = "e2e_deployment",
    cpp_namespace = "ovf::deployment::per_e2e",
    deployment = "deployment.cue",
)

cc_binary(
    name = "e2e_app",
    srcs = ["e2e_app.cpp"],
    deps = [
        ":e2e_deployment",
        "//per:sqlite_provider",
    ],
)

py_test(
    name = "process_e2e_test",
    size = "medium",
    srcs = ["e2e_test.py"],
    args = ["$(rootpath :e2e_app)"],
    data = [":e2e_app"],
    main = "e2e_test.py",
)

cc_test(
    name = "c_abi_test",
    srcs = ["c_abi_test.c"],
    deps = ["//per:provider_abi"],
)

cc_test(
    name = "memory_provider_test",
    srcs = ["memory_provider_test.cpp"],
    deps = [
        "//per:memory_provider",
        "//per:runtime",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "sqlite_provider_test",
    size = "medium",
    srcs = ["sqlite_provider_test.cpp"],
    deps = [
        "//per:runtime",
        "//per:sqlite_provider",
        "@googletest//:gtest_main",
    ],
)

test_suite(
    name = "all_tests",
    tests = [
        ":c_abi_test",
        ":memory_provider_test",
        ":process_e2e_test",
        ":sqlite_provider_test",
        ":typed_contract_test",
    ],
)
