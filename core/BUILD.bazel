load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "core",
    hdrs = ["include/ovf/core/result.hpp"],
    copts = ["-std=c++20"],
    includes = ["include"],
)

cc_test(
    name = "result_test",
    srcs = ["tests/result_test.cpp"],
    copts = ["-std=c++20"],
    deps = [
        ":core",
        "@googletest//:gtest_main",
    ],
)
