package(default_visibility = ["//visibility:public"])

config_setting(
    name = "darwin_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

filegroup(
    name = "smithy",
    srcs = select({
        ":darwin_aarch64": ["@smithy_cli_darwin_aarch64//:bin/smithy"],
        ":linux_aarch64": ["@smithy_cli_linux_aarch64//:bin/smithy"],
        ":linux_x86_64": ["@smithy_cli_linux_x86_64//:bin/smithy"],
    }),
)

filegroup(
    name = "smithy_runtime",
    srcs = select({
        ":darwin_aarch64": ["@smithy_cli_darwin_aarch64//:runtime"],
        ":linux_aarch64": ["@smithy_cli_linux_aarch64//:runtime"],
        ":linux_x86_64": ["@smithy_cli_linux_x86_64//:runtime"],
    }),
)
