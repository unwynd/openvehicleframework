# SPDX-License-Identifier: Apache-2.0

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

exports_files(["LICENSE"])

cc_binary(
    name = "mconfig_gen",
    srcs = ["build/tools/mconfig-gen.cc"],
)

genrule(
    name = "mconfig",
    outs = ["mconfig.h"],
    cmd = "$(execpath :mconfig_gen) " +
          "VERSION=6c027cde " +
          "SYSCONTROLSOCKET=/run/dinitctl " +
          "BINDIR=/usr/bin " +
          "SBINDIR=/usr/sbin " +
          "SHUTDOWN_PREFIX=/usr " +
          "USE_INITGROUPS=1 " +
          "SUPPORT_CGROUPS=0 " +
          "SUPPORT_CAPABILITIES=0 " +
          "SUPPORT_IOPRIO=0 " +
          "SUPPORT_OOM_ADJ=0 " +
          "DEFAULT_AUTO_RESTART=ALWAYS " +
          "DEFAULT_START_TIMEOUT=60 " +
          "DEFAULT_STOP_TIMEOUT=10 > $@",
    tools = [":mconfig_gen"],
)

cc_library(
    name = "client",
    hdrs = glob([
        "dasynq/include/**/*.h",
        "src/includes/*.h",
    ]) + [":mconfig"],
    includes = [
        ".",
        "dasynq/include",
        "src/includes",
    ],
)

cc_binary(
    name = "dinit-check",
    srcs = [
        "src/dinit-check.cc",
        "src/dinit-client.cc",
        "src/dinit-iostream.cc",
        "src/options-processing.cc",
        "src/settings.cc",
    ],
    copts = [
        "-std=c++17",
        "-Wno-error=unused-parameter",
    ],
    includes = [
        ".",
        "dasynq/include",
        "src/includes",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:osx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":client"],
)

cc_binary(
    name = "dinit",
    srcs = [
        "src/baseproc-service.cc",
        "src/control.cc",
        "src/dinit.cc",
        "src/dinit-env.cc",
        "src/dinit-iostream.cc",
        "src/dinit-log.cc",
        "src/dinit-main.cc",
        "src/load-service.cc",
        "src/options-processing.cc",
        "src/proc-service.cc",
        "src/run-child-proc.cc",
        "src/service.cc",
        "src/settings.cc",
    ],
    copts = [
        "-std=c++17",
        "-Wno-error=unused-parameter",
    ],
    includes = [
        ".",
        "dasynq/include",
        "src/includes",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:osx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":client"],
)
