load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE_1_0.txt"])

filegroup(
    name = "source",
    srcs = glob(["**"]),
)

cmake(
    name = "boost",
    cache_entries = {
        "BOOST_ENABLE_CMAKE": "ON",
        "BOOST_INCLUDE_LIBRARIES": ";".join([
            "algorithm",
            "array",
            "asio",
            "container_hash",
            "date_time",
            "exception",
            "filesystem",
            "foreach",
            "functional",
            "icl",
            "interprocess",
            "process",
            "property_tree",
            "smart_ptr",
            "stacktrace",
            "system",
            "utility",
        ]),
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
    },
    lib_source = ":source",
    out_include_dir = "include",
    out_static_libs = ["libboost_filesystem.a"],
)
