load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "source",
    srcs = glob(["**"]),
)

cmake(
    name = "vsomeip",
    cache_entries = {
        "CMAKE_BUILD_TYPE": "Release",
        "DISABLE_DLT": "ON",
        "ENABLE_SIGNAL_HANDLING": "OFF",
        "VSOMEIP_DISABLE_ENV_VARS": "ON",
    },
    deps = ["@boost_source//:boost"],
    lib_source = ":source",
    out_include_dir = "include",
    out_shared_libs = [
        "libvsomeip3.so",
        "libvsomeip3.so.3",
        "libvsomeip3-cfg.so",
        "libvsomeip3-cfg.so.3",
        "libvsomeip3-e2e.so",
        "libvsomeip3-e2e.so.3",
        "libvsomeip3-sd.so",
        "libvsomeip3-sd.so.3",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)
