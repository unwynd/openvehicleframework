genrule(
    name = "smithy_model",
    srcs = [
        "//com/model:ovf-profile.smithy",
        "//com/model:smithy-build.json",
        "//contracts/radar",
    ],
    outs = ["smithy/ovf/model/model.json"],
    cmd = "$(location //bazel/host_tools:smithy) build " +
          "--config $(location //com/model:smithy-build.json) " +
          "--output $(RULEDIR)/smithy-tmp --no-color >/dev/null && " +
          "cp $(RULEDIR)/smithy-tmp/ovf/model/model.json $@",
    tools = [
        "//bazel/host_tools:smithy",
        "//bazel/host_tools:smithy_runtime",
    ],
)

genrule(
    name = "smithy_ir",
    srcs = [":smithy_model"],
    outs = ["smithy/radar.ovf-ir.json"],
    cmd = "$(execpath //tools:smithy_ast_to_ir) $(location :smithy_model) --output $@",
    tools = ["//tools:smithy_ast_to_ir"],
)

