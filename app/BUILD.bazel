load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "app",
    hdrs = ["include/ovf/app/run.hpp"],
    copts = ["-std=c++20"],
    includes = ["include"],
    deps = [
        "//com:runtime",
        "//exec:application",
        "//log:runtime",
    ],
)

cc_test(
    name = "run_compile_test",
    srcs = ["tests/run_compile_test.cpp"],
    copts = ["-std=c++20"],
    deps = [":app"],
)
