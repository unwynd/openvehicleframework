# SPDX-License-Identifier: Apache-2.0

common --enable_bzlmod
common --lockfile_mode=update
common --incompatible_strict_action_env
common --incompatible_default_to_explicit_init_py
build --announce_rc
build --show_timestamps
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20
build:strict --copt=-Wall
build:strict --copt=-Wextra
build:strict --copt=-Werror
# The pinned LLVM toolchain passes its C++ standard-library selection during
# compile actions; Clang diagnoses that linker-oriented argument as unused on
# Linux. Keep source warnings fatal while leaving this toolchain diagnostic
# non-fatal.
build:strict --copt=-Wno-error=unused-command-line-argument
build:release --compilation_mode=opt
build:release --strip=never
build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --linkopt=-fsanitize=address
test:asan --test_env=ASAN_OPTIONS=detect_leaks=0
build:tsan --copt=-fsanitize=thread
build:tsan --copt=-fno-omit-frame-pointer
build:tsan --linkopt=-fsanitize=thread
build:linux-x86_64 --platforms=//bazel/platforms:linux_x86_64
build:linux-aarch64 --platforms=//bazel/platforms:linux_aarch64
build:macos-aarch64 --platforms=//bazel/platforms:macos_aarch64
build:qnx-x86_64 --platforms=//bazel/platforms:qnx_x86_64
build:qnx-aarch64 --platforms=//bazel/platforms:qnx_aarch64
test --test_output=errors
test --keep_going
