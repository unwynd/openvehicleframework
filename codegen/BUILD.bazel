load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "ovf_codegen",
    srcs = ["src/main.rs"],
    compile_data = [
        "templates/cpp_deployment.hpp.j2",
        "templates/cpp_log.hpp.j2",
        "templates/cpp_per.hpp.j2",
        "templates/cpp_contract.hpp.j2",
        "templates/cpp_application.hpp.j2",
        "templates/dinit_boot.j2",
        "templates/dinit_daemon.j2",
        "templates/dinit_service.j2",
        "tests/fixtures/empty.ovf-ir.json",
        "tests/golden/empty.hpp",
        "//com/model/examples:radar_ir",
    ],
    edition = "2024",
    deps = [
        "@crates//:minijinja",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "ovf_codegen_test",
    crate = ":ovf_codegen",
)

rustfmt_test(
    name = "rustfmt_test",
    targets = [":ovf_codegen"],
)
