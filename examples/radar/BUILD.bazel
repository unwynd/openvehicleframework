load("//bazel:application.bzl", "ovf_cc_application")

package(default_visibility = ["//visibility:public"])

ovf_cc_application(
    name = "radar_inproc_client",
    srcs = ["client/main.cpp"],
    deployment = "client/ipc-deployment.cue",
    interfaces = ["//examples/radar/interface:radar"],
    logging = True,
    tags = ["manual"],
)

ovf_cc_application(
    name = "radar_service",
    srcs = ["service/main.cpp"],
    deployment = "service/deployment.cue",
    interfaces = ["//examples/radar/interface:radar"],
    logging = True,
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

ovf_cc_application(
    name = "radar_iceoryx2_service",
    srcs = ["service/main.cpp"],
    application_name = "radar",
    deployment = "service/ipc-deployment.cue",
    interfaces = ["//examples/radar/interface:radar"],
    logging = True,
    tags = ["manual"],
)

ovf_cc_application(
    name = "radar_iceoryx2_client",
    srcs = ["client/main.cpp"],
    deployment = "client/ipc-deployment.cue",
    interfaces = ["//examples/radar/interface:radar"],
    logging = True,
    tags = ["manual"],
)

ovf_cc_application(
    name = "radar_client",
    srcs = ["client/main.cpp"],
    deployment = "client/deployment.cue",
    interfaces = ["//examples/radar/interface:radar"],
    logging = True,
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)
