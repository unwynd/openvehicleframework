load("//bazel:application.bzl", "ovf_cc_application")

package(default_visibility = ["//visibility:public"])

ovf_cc_application(
    name = "radar_inproc_client",
    srcs = ["client/main.cpp"],
    deployment = "client/deployment.cue",
    deployment_namespace = "radar_client_deployment",
    idl = ["//contracts/radar:radar.smithy"],
    platform = "//platform:providers/inproc.cue",
    tags = ["manual"],
)

ovf_cc_application(
    name = "radar_service",
    srcs = ["service/main.cpp"],
    deployment = "service/deployment.cue",
    idl = ["//contracts/radar:radar.smithy"],
    platform = "//platform:providers/vsomeip.cue",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

