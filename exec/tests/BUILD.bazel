load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "dinit_test_service",
    srcs = ["dinit_test_service.cpp"],
)

cc_test(
    name = "backend_abi_test",
    srcs = ["backend_abi_test.c"],
    deps = ["//exec:backend_abi"],
)

py_test(
    name = "generated_dinit_test",
    srcs = ["generated_dinit_test.py"],
    data = [
        "//examples/execution:dinit_services",
        "@dinit_source//:dinit-check",
    ],
    env = {
        "OVF_TEST_DINIT_CHECK": "$(rootpath @dinit_source//:dinit-check)",
        "OVF_TEST_DINIT_SERVICES": "$(rootpath //examples/execution:dinit_services)",
    },
    main = "generated_dinit_test.py",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:osx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

