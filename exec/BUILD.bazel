load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "model",
    srcs = ["src/model.cpp"],
    hdrs = [
        "include/ovf/exec/error.hpp",
        "include/ovf/exec/model.hpp",
        "include/ovf/exec/types.hpp",
    ],
    copts = ["-std=c++20"],
    includes = ["include"],
)

cc_library(
    name = "application",
    srcs = [
        "src/application.cpp",
        "src/dinit_lifecycle.cpp",
    ],
    hdrs = [
        "include/ovf/exec/application.hpp",
        "include/ovf/exec/internal/lifecycle_backend.hpp",
    ],
    copts = ["-std=c++20"],
    includes = ["include"],
    deps = [":model"],
)

cc_library(
    name = "planner",
    srcs = ["src/planner.cpp"],
    hdrs = ["include/ovf/exec/internal/planner.hpp"],
    copts = ["-std=c++20"],
    includes = ["include"],
    deps = [":model"],
)

cc_library(
    name = "scheduler",
    srcs = ["src/scheduler.cpp"],
    hdrs = ["include/ovf/exec/internal/scheduler.hpp"],
    copts = ["-std=c++20"],
    includes = ["include"],
    deps = [
        ":application",
        ":model",
    ],
)

alias(
    name = "exec",
    actual = ":application",
)
