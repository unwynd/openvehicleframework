# SPDX-License-Identifier: Apache-2.0

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "backend_abi",
    hdrs = ["include/ovf/exec/backend_abi.h"],
    includes = ["include"],
)

cc_library(
    name = "model",
    srcs = ["src/model.cpp"],
    hdrs = [
        "include/ovf/exec/error.hpp",
        "include/ovf/exec/model.hpp",
        "include/ovf/exec/types.hpp",
    ],
    copts = ["-std=c++20"],
    includes = ["include"],
)

cc_library(
    name = "application",
    srcs = [
        "src/application.cpp",
        "src/dinit_lifecycle.cpp",
    ],
    hdrs = [
        "include/ovf/exec/application.hpp",
        "include/ovf/exec/internal/lifecycle_backend.hpp",
    ],
    copts = ["-std=c++20"],
    includes = ["include"],
    deps = [":model"],
)

cc_library(
    name = "planner",
    srcs = ["src/planner.cpp"],
    hdrs = ["include/ovf/exec/internal/planner.hpp"],
    copts = ["-std=c++20"],
    includes = ["include"],
    deps = [":model"],
)

cc_library(
    name = "scheduler",
    srcs = ["src/scheduler.cpp"],
    hdrs = ["include/ovf/exec/internal/scheduler.hpp"],
    copts = ["-std=c++20"],
    includes = ["include"],
    deps = [
        ":application",
        ":model",
    ],
)

cc_library(
    name = "engine",
    srcs = ["src/engine.cpp"],
    hdrs = ["include/ovf/exec/internal/engine.hpp"],
    copts = ["-std=c++20"],
    includes = ["include"],
    deps = [
        ":planner",
        ":scheduler",
    ],
)

cc_library(
    name = "coordinator",
    srcs = ["src/coordinator.cpp"],
    hdrs = [
        "include/ovf/exec/coordinator.hpp",
        "include/ovf/exec/internal/coordinator_service.hpp",
    ],
    copts = ["-std=c++20"],
    includes = ["include"],
    deps = [
        ":application",
        ":engine",
        ":model",
    ],
)

cc_library(
    name = "backend_binding",
    srcs = ["src/backend_binding.cpp"],
    hdrs = ["include/ovf/exec/internal/backend_binding.hpp"],
    copts = ["-std=c++20"],
    includes = ["include"],
    deps = [
        ":backend_abi",
        ":engine",
    ],
)

cc_library(
    name = "dinit_backend",
    srcs = ["backends/dinit.cpp"],
    hdrs = ["include/ovf/exec/backends/dinit.hpp"],
    copts = ["-std=c++20"],
    includes = ["include"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:osx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":engine",
        "@dinit_source//:client",
    ],
)

alias(
    name = "exec",
    actual = ":application",
)
